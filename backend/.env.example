# Copier en .env et remplir. Ne jamais committer .env (il contient des secrets).

# --- Supabase via le pooler Supavisor ---
# L'hôte direct db.<ref>.supabase.co est IPv6 uniquement : utiliser le pooler.
# Caractères spéciaux du mot de passe à encoder pour l'URL (% -> %25, * -> %2A, ^ -> %5E, + -> %2B)
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://postgres.<ref>:<mot-de-passe-encode>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30"

# --- Base locale (npm run db:use local) ---
# DATABASE_URL="postgresql://lezhe:lezhepassword@localhost:5432/lezhe?schema=public"
# DIRECT_URL="postgresql://lezhe:lezhepassword@localhost:5432/lezhe?schema=public"

JWT_SECRET="change-moi-par-une-chaine-aleatoire-longue"
REDIS_HOST="localhost"
REDIS_PORT=6379
ANTHROPIC_API_KEY=""          # vide = mode dégradé (aucun appel payant)
ANTHROPIC_MODEL="claude-sonnet-5"
PORT=3001
FRONTEND_URL="http://localhost:3000"
